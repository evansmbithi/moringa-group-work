.user-dashboard{
  display: flex;
  flex-direction: column;
  width: 100%;
  max-height: 100vh;
}

.nav {
  display: flex;
  justify-content: space-between;
  width: 100%;
  height: 1.3rem;
  padding: 8px 10px 0 10px;
  margin-right: 100px;
  background-color: #1AA0B8;

}

.logo {
  height: 1.2rem;
  width: 1.5rem;  
}

.svg{
  color: #fff;
}

