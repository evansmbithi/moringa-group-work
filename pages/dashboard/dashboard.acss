*{
  font-size: 16px;
  font-family: sans-serif;
}


.user-dashboard{
  display: flex;
  flex-direction: column;
  width: 100%;
  max-height: 100vh;
}

.nav {
  display: flex;
  justify-content: space-between;
  width: 100%;
  height: 1.2rem;
  padding: 0.15rem;
  background-color: #1b6dd1;

}

.logo {
  height: 1.2rem;
  width: 1.3rem;  
}

.container{  
  padding-bottom: 0.3rem;
  height: 90vh;
  display: flex;
  flex-direction: column;
  justify-content: space-evenly;
  background-color: #f0f0f0;
}

.header{
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  height: 25vh;
  margin: 0.4rem;
  padding: 0.4rem;
  background: #f0f0f0 url("../../assets/PaypalLogoCompressed.jpg") no-repeat center center;
  background-size: cover;
  border-radius: 10px;
}

.h1{
  font-weight: bold;
  font-size: 0.5rem;
}

.h2{
  font-weight: bold;
  font-size: large;
}

.h3{
  font-weight: bold;
  font-size: large;
}

.margin-top{
  margin-top: 0.5rem;
}


.text{
  display: block;
  text-align: center;
}

.body-text{
  display: block;
  text-align: left;
  padding: 5px;
}

.body{
  display: flex;
  flex-direction: column;
  justify-content: space-around;
  height: 30vh;
  margin: 0.4rem;
  padding: 0.1rem 0.4rem; /* top | left and right | bottom */
  background-color: #b1a9a986;
  border-radius: 10px;
}

.balance-info{
  margin-left: 1rem;
  
}


.transact{
  display: flex;
  justify-content: space-around;
  width: 100%;
  margin: 0.4rem 0 0.4rem 0;
}

.btn{
  padding:  0 0.4rem 0.4rem;
  border-radius: 20px;
  min-width: 2.8rem;
  background-color: #1b6dd1;
}

.green{
  background-color: green;
}